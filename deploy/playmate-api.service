[Unit]
Description=Playmate API (Go)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/playmate-backend
Environment=TZ=Asia/Shanghai
ExecStart=/www/wwwroot/playmate-backend/playmate-api
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
